PORT=3001
NODE_ENV=development

# Motor de base de datos: 'mysql' o 'json'
DB_ENGINE=mysql

# JWT
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# MySQL (usado cuando DB_ENGINE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=domicilios_palermo
DB_PORT=3306

# Firebase Admin (para notificaciones push)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Google OAuth (para Sign In with Google)
GOOGLE_CLIENT_ID=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Payment
PAYMENT_LINK_BASE_URL=https://checkout.example.com

# Cloudinary (para almacenar imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS (optional)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ADMIN_PHONE=

# Reportes contables
IVA_RATE=0.19
COMISION_DEFAULT=10